generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  DEPROVISIONING
}

enum PolicyScope {
  SYSTEM
  FACILITY
}

enum PolicyNodeType {
  FOLDER
  DOCUMENT
}

enum IngestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum UsageTokenType {
  INPUT
  OUTPUT
}

model Tenant {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  status              TenantStatus     @default(ACTIVE)
  stripeCustomerId    String?          @unique
  stripeSubscriptionId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  settings            Json
  ssoConfig           Json
  features            Json
  apiKeys             ApiKey[]
  facilities          Facility[]
  users               TenantUser[]
  policyNodes         PolicyNode[]
  policyDocuments     PolicyDocument[]
  policyVersions      PolicyVersion[]
  policyChunks        PolicyChunk[]
  ingestJobs          IngestJob[]
  chatSessions        ChatSession[]
  chatMessages        ChatMessage[]
  auditEvents         AuditEvent[]
  usageEvents         UsageEvent[]
  usageAggregates     UsageAggregate[]
}

model Facility {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String
  timezone   String
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  policyNodes PolicyNode[]
  chatSessions ChatSession[]
  policyDocuments PolicyDocument[]
  policyChunks   PolicyChunk[]
  ingestJobs     IngestJob[]
  usageEvents    UsageEvent[]

  @@index([tenantId, code])
}

model TenantUser {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sub         String
  email       String
  displayName String?
  roles       String[]     @db.Text
  facilities  String[]     @db.Text
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, sub])
  @@index([tenantId, email])
}

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  hashedKey   String
  scopes      String[] @db.Text
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([tenantId, name])
}

model PolicyNode {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      PolicyNode?   @relation("PolicyNodeToPolicyNode", fields: [parentId], references: [id])
  children    PolicyNode[]  @relation("PolicyNodeToPolicyNode")
  facilityId  String?
  facility    Facility?     @relation(fields: [facilityId], references: [id])
  scope       PolicyScope   @default(SYSTEM)
  type        PolicyNodeType
  name        String
  slug        String
  path        String[]       @db.Text
  depth       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  document    PolicyDocument?

  @@index([tenantId, slug])
  @@index([tenantId, path])
}

model PolicyDocument {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nodeId          String         @unique
  node            PolicyNode     @relation(fields: [nodeId], references: [id])
  facilityId      String?
  facility        Facility?      @relation(fields: [facilityId], references: [id])
  title           String
  summary         String?
  category        String
  tags            String[]        @db.Text
  ownerEmail      String
  effectiveAt     DateTime
  reviewAt        DateTime?
  isActive        Boolean         @default(true)
  latestVersionId String?         @unique
  latestVersion   PolicyVersion?  @relation("LatestVersion", fields: [latestVersionId], references: [id])
  versions        PolicyVersion[]
  ingestJobs      IngestJob[]

  @@index([tenantId, category])
  @@index([tenantId, facilityId])
}

model PolicyVersion {
  id               String        @id @default(uuid())
  documentId       String
  document         PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionNumber    Int
  checksum         String
  storageKey       String
  markdownSizeBytes Int
  ingestedAt       DateTime      @default(now())
  ingestedBy       String
  exportedSourceUrl String?
  changeSummary    String?
  chunks           PolicyChunk[]
  latestForDocument PolicyDocument? @relation("LatestVersion")

  @@unique([documentId, versionNumber])
  @@index([tenantId, checksum])
}

model PolicyChunk {
  id               String        @id @default(uuid())
  versionId        String
  version          PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityId       String?
  facility         Facility?     @relation(fields: [facilityId], references: [id])
  chunkIndex       Int
  text             String        @db.Text
  tokenCount       Int
  embeddingModel   String
  pineconeNamespace String
  pineconeId       String        @unique
  headings         String[]      @db.Text
  path             String[]      @db.Text
  createdAt        DateTime      @default(now())

  @@index([tenantId, pineconeNamespace])
}

model IngestJob {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityId   String?
  facility     Facility?    @relation(fields: [facilityId], references: [id])
  documentId   String?
  document     PolicyDocument? @relation(fields: [documentId], references: [id])
  status       IngestStatus  @default(QUEUED)
  sourcePath   String
  sourceHash   String
  queuedBy     String
  startedAt    DateTime? 
  completedAt  DateTime?
  error        Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId, status])
}

model ChatSession {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityId  String?
  facility    Facility?     @relation(fields: [facilityId], references: [id])
  userId      String
  topic       String?
  contextNodeIds String[]    @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    ChatMessage[]

  @@index([tenantId, userId])
}

model ChatMessage {
  id          String           @id @default(cuid())
  sessionId   String
  session     ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        ChatMessageRole
  content     String           @db.Text
  tokenCount  Int
  latencyMs   Int?
  createdAt   DateTime         @default(now())
  sources     Json?

  @@index([tenantId, sessionId])
}

model UsageEvent {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityId    String?
  facility      Facility?     @relation(fields: [facilityId], references: [id])
  sessionId     String?
  tokenType     UsageTokenType
  tokenCount    Int
  model         String
  occurredAt    DateTime      @default(now())
  requestId     String?
  metadata      Json?

  @@index([tenantId, occurredAt])
}

model UsageAggregate {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hour            DateTime
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  totalCostCents  Int       @default(0)
  stripeMeterEventId String?

  @@unique([tenantId, hour])
}

model AuditEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String
  actorEmail  String?
  facilityId  String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
}

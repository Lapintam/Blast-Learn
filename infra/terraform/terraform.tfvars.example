project       = "policy-manager"
environment   = "prod"
aws_region    = "us-east-1"

alb_oidc_client_id     = "your-oidc-client-id"
alb_oidc_client_secret = "your-oidc-client-secret"
alb_oidc_issuer        = "https://login.microsoftonline.com/<tenant_id>/v2.0"

instance_type = "m6i.large"
asg_min_size  = 2
asg_max_size  = 6
asg_desired_capacity = 2

key_name = null
